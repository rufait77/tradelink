{
  "name": "@tradelink/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@tradelink/types": "*",
    "@tradelink/validators": "*",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.5.0",
    "rate-limiter-flexible": "^5.0.5",
    "@prisma/client": "^6.5.0",
    "zod": "^3.24.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0",
    "axios": "^1.8.3",
    "stripe": "^17.7.0",
    "bull": "^4.16.5",
    "ioredis": "^5.6.0",
    "resend": "^4.0.1",
    "multer": "^1.4.5-lts.2",
    "sharp": "^0.33.5",
    "dotenv": "^16.4.7",
    "date-fns": "^4.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/bull": "^4.10.0",
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3",
    "tsx": "^4.19.3",
    "prisma": "^6.5.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  }
}

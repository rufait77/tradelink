# ─── API ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://tradelink_user:your_password@localhost:5432/tradelink_db"
REDIS_URL="redis://:your_redis_password@localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_64_chars"
JWT_REFRESH_SECRET="change_this_to_another_long_random_secret_64_chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Admin has a separate secret for its JWT
ADMIN_JWT_SECRET="change_this_to_admin_specific_secret_64_chars"

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="Tradelink <noreply@tradelink.rufaitlabs.cloud>"

# ─── App URLs ────────────────────────────────────────────────────────────────
API_URL="https://api.tradelink.rufaitlabs.cloud"
WEB_URL="https://tradelink.rufaitlabs.cloud"
ADMIN_URL="https://admin.tradelink.rufaitlabs.cloud"

# Local dev
# API_URL="http://localhost:4000"
# WEB_URL="http://localhost:3000"
# ADMIN_URL="http://localhost:3001"

# ─── File Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="5"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="4000"

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  contractor
  admin
}

enum TradeType {
  Landscaping
  Roofing
  HVAC
  Plumbing
  Electrical
  Painting
  Carpentry
  Flooring
  Masonry
  Cleaning
  PressureWashing
  JunkRemoval
  WindowInstallation
  Siding
  Clearing
  GeneralContracting
  Welding
  Drywall
  Barber
  Cosmetology
  Esthetician
  AutoMechanics
  Other
}

enum JobUrgency {
  Low
  Medium
  High
  Emergency
}

enum JobStatus {
  Open              // posted, interest window active
  InterestClosed    // interest window ended, referee choosing
  Assigned          // contractor assigned, quote pending
  QuoteSent         // quote sent to client
  QuoteApproved     // client approved quote
  EscrowFunded      // client paid, funds in escrow
  InProgress        // work underway
  ContractorDone    // contractor marked complete
  ClientConfirmed   // client confirmed — triggers fund release
  Completed         // funds released, job done
  Disputed          // dispute raised
  Cancelled
  Expired
}

enum InterestStatus {
  pending           // contractor expressed interest, waiting
  selected          // referee selected this contractor
  rejected          // referee chose someone else
  withdrawn         // contractor withdrew interest
}

enum QuoteStatus {
  draft
  sent              // sent to client for approval
  approved          // client approved
  rejected          // client rejected
  revised           // superseded by a revision
  cancelled
}

enum EscrowStatus {
  pending           // payment link sent, not yet paid
  funded            // client paid, funds held
  released          // job complete, funds distributed
  refunded          // dispute resolved, client refunded
  disputed          // dispute in progress, funds frozen
}

enum DisputeStatus {
  open
  under_review
  resolved_contractor   // resolved in contractor's favor
  resolved_client       // resolved in client's favor
  closed
}

enum StrikeType {
  ghost              // contractor ghosted after assignment
  bypass_attempt     // attempted off-platform dealing
  client_report      // client reported an issue
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum CommissionStatus {
  pending
  paid
  failed
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  trialing
  incomplete
}

enum StripeConnectStatus {
  not_connected
  pending
  active
}

enum NotificationType {
  // ─── Existing types ───
  job_claimed
  job_started
  job_completed
  commission_paid
  payout_failed
  subscription_renewed
  subscription_expiring
  subscription_cancelled
  review_received
  message_received
  announcement
  // ─── Interest & Assignment ───
  interest_received       // referee: someone expressed interest
  interest_selected       // contractor: you were selected
  interest_rejected       // contractor: someone else was chosen
  job_assigned            // contractor: you've been assigned
  // ─── Quote lifecycle ───
  quote_sent              // referee: quote sent to client
  quote_approved          // contractor + referee: client approved
  quote_rejected          // contractor: client rejected
  // ─── Payment & Escrow ───
  escrow_funded           // contractor + referee: client paid
  contractor_completed    // referee: contractor marked done
  client_confirmed        // contractor + referee: client confirmed
  funds_released          // contractor + referee: money distributed
  // ─── Disputes ───
  dispute_raised          // admin + contractor: dispute filed
  dispute_resolved        // contractor + referee: dispute resolved
  // ─── Trust & Safety ───
  ghost_warning           // contractor: respond or lose assignment
  ghost_strike            // contractor: strike added
  penalty_warning         // contractor: formal warning
  penalty_suspension      // contractor: access suspended
  penalty_ban             // contractor: permanent ban
  // ─── Ratings ───
  review_prompt           // contractor + referee: please rate
  // ─── Direct Messaging ───
  direct_message          // new DM received
  message_reported        // admin: message reported
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(contractor)
  isVerified          Boolean   @default(false)
  isActive            Boolean   @default(true)
  stripeCustomerId    String?   @unique
  stripeConnectId     String?   @unique
  emailVerifyToken    String?
  emailVerifyExpiry   DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  profile          ContractorProfile?
  postedJobs       Job[]              @relation("PostedJobs")
  claimedJobs      Job[]              @relation("ClaimedJobs")
  commissions      Commission[]
  subscription     Subscription?
  reviewsGiven     Review[]           @relation("ReviewsGiven")
  reviewsReceived  Review[]           @relation("ReviewsReceived")
  notifications    Notification[]
  sentMessages     Message[]          @relation("SentMessages")
  receivedMessages Message[]          @relation("ReceivedMessages")
  dmSent           DirectMessage[]    @relation("DmSent")
  dmReceived       DirectMessage[]    @relation("DmReceived")
  auditLogs        AuditLog[]
  interests        JobInterest[]      @relation("ContractorInterests")
  quotes           Quote[]            @relation("ContractorQuotes")
  strikes          ContractorStrike[] @relation("ContractorStrikes")

  @@map("users")
}

model ContractorProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  tradeTypes          TradeType[]
  bio                 String              @default("")
  licenseNumber       String?
  licenseFileUrl      String?             // uploaded license document
  insuranceUrl        String?             // uploaded insurance document
  certifications      Json?               // array of { name, fileUrl, verified }
  streetAddress       String              @default("")
  city                String              @default("")
  state               String              @default("") // US State abbreviation e.g. "TX"
  zipCode             String              @default("") // 5-digit US ZIP
  yearsExperience     Int                 @default(0)
  avgRating           Float               @default(0)
  avgResponseTime     Float?              // hours, auto-calculated from job interactions
  totalEarned         Float               @default(0)
  totalReferrals      Int                 @default(0)
  totalJobsCompleted  Int                 @default(0)
  photoUrl            String?
  stripeConnectStatus StripeConnectStatus @default(not_connected)
  notificationPrefs   Json                @default("{\"email_job_claimed\":true,\"email_job_completed\":true,\"email_commission_paid\":true,\"email_renewal_reminder\":true,\"inapp_messages\":true,\"inapp_job_updates\":true,\"inapp_announcements\":true}")
  onboardingComplete  Boolean             @default(false)
  isAdminVerified     Boolean             @default(false) // admin verified license/insurance
  // ─── Trust & Safety ───
  ghostStrikes        Int                 @default(0)
  bypassWarnings      Int                 @default(0)
  isSuspended         Boolean             @default(false)
  suspendedUntil      DateTime?
  isBanned            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contractor_profiles")
}

model Job {
  id                    String     @id @default(uuid())
  postedById            String
  claimedById           String?
  title                 String
  description           String
  tradeType             TradeType
  budgetMin             Float
  budgetMax             Float
  estimatedValue        Float?             // single estimated value for fee calculation
  streetAddress         String
  city                  String
  state                 String             // US State abbreviation e.g. "TX"
  zipCode               String             // 5-digit US ZIP
  serviceRadiusMiles    Int?               // geo-filter radius for visibility
  urgency               JobUrgency @default(Low)
  status                JobStatus  @default(Open)
  clientName            String?
  clientNote            String?            // private notes, only visible to assigned contractor
  expiresAt             DateTime
  // ─── Interest & Assignment lifecycle ───
  interestWindowEnd     DateTime?          // 24hrs after posting
  assignedAt            DateTime?          // when contractor was assigned
  // ─── Completion lifecycle ───
  contractorCompletedAt DateTime?          // when contractor marked done
  clientConfirmedAt     DateTime?          // when client confirmed
  autoReleaseAt         DateTime?          // 5 days after contractorCompletedAt
  completionPhotos      String[]           // URLs of before/after photos
  completionNotes       String?            // contractor's completion notes
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  postedBy   User           @relation("PostedJobs", fields: [postedById], references: [id])
  claimedBy  User?          @relation("ClaimedJobs", fields: [claimedById], references: [id])
  payment    JobPayment?
  commission Commission?
  reviews    Review[]
  messages   Message[]
  clientLead ClientLead?
  interests  JobInterest[]
  quotes     Quote[]
  escrow     EscrowPayment?
  disputes   Dispute[]

  @@index([status])
  @@index([tradeType])
  @@index([state])
  @@index([zipCode])
  @@index([createdAt])
  @@index([postedById])
  @@index([claimedById])
  @@map("jobs")
}

// ─── Client Lead — stores client contact info, gated behind assignment ──────

model ClientLead {
  id            String    @id @default(uuid())
  jobId         String    @unique
  firstName     String
  lastName      String
  email         String
  phone         String?
  streetAddress String
  city          String
  state         String
  zipCode       String
  accessToken   String    @unique @default(uuid()) // secure guest access token
  tokenExpiry   DateTime                           // e.g. 30 days after job complete
  notes         String?                            // private notes from referee
  createdAt     DateTime  @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([accessToken])
  @@map("client_leads")
}

// ─── Job Interest — contractors express interest, referee selects ────────────

model JobInterest {
  id           String         @id @default(uuid())
  jobId        String
  contractorId String
  message      String?        // optional pitch from contractor
  status       InterestStatus @default(pending)
  createdAt    DateTime       @default(now())

  job        Job  @relation(fields: [jobId], references: [id])
  contractor User @relation("ContractorInterests", fields: [contractorId], references: [id])

  @@unique([jobId, contractorId]) // one interest per contractor per job
  @@index([jobId])
  @@index([contractorId])
  @@map("job_interests")
}

// ─── Quote — formal job quote sent to client for approval ───────────────────

model Quote {
  id             String      @id @default(uuid())
  jobId          String
  contractorId   String
  amount         Float       // final agreed price
  scope          String      // scope of work description
  scheduledDate  DateTime    // when work will happen
  status         QuoteStatus @default(draft)
  clientToken    String      @unique @default(uuid()) // unique token for client quote approval
  revisionOfId   String?     // links to previous quote if revision
  rejectionNote  String?     // client's reason for rejection
  platformFeePct Float       // snapshot at quote time
  commissionPct  Float       // snapshot at quote time
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  job        Job     @relation(fields: [jobId], references: [id])
  contractor User    @relation("ContractorQuotes", fields: [contractorId], references: [id])
  revisionOf Quote?  @relation("QuoteRevisions", fields: [revisionOfId], references: [id])
  revisions  Quote[] @relation("QuoteRevisions")
  escrow     EscrowPayment?

  @@index([jobId])
  @@index([contractorId])
  @@map("quotes")
}

// ─── Escrow Payment — holds client funds until job completion ────────────────

model EscrowPayment {
  id                    String       @id @default(uuid())
  jobId                 String       @unique
  quoteId               String       @unique
  stripePaymentIntentId String?      @unique
  stripeCheckoutId      String?      // Stripe Checkout session ID
  totalAmount           Float
  platformFeeAmount     Float
  commissionAmount      Float
  contractorAmount      Float
  status                EscrowStatus @default(pending)
  paymentLink           String?      // Stripe Checkout URL for client
  paidAt                DateTime?
  releasedAt            DateTime?
  createdAt             DateTime     @default(now())

  job   Job   @relation(fields: [jobId], references: [id])
  quote Quote @relation(fields: [quoteId], references: [id])

  @@map("escrow_payments")
}

// ─── Dispute — raised by client or contractor, resolved by admin ────────────

model Dispute {
  id          String        @id @default(uuid())
  jobId       String
  raisedBy    String        // "client" or a userId
  reason      String
  evidence    String?       // JSON: array of photo URLs, message IDs
  status      DisputeStatus @default(open)
  adminNotes  String?
  resolvedBy  String?       // admin userId
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([status])
  @@map("disputes")
}

// ─── Contractor Strike — tracks penalties for trust violations ──────────────

model ContractorStrike {
  id           String     @id @default(uuid())
  contractorId String
  type         StrikeType
  jobId        String?    // related job if applicable
  reason       String
  isWarning    Boolean    @default(true) // true = warning only, false = active strike
  createdAt    DateTime   @default(now())

  contractor User @relation("ContractorStrikes", fields: [contractorId], references: [id])

  @@index([contractorId])
  @@map("contractor_strikes")
}

// ─── Existing models (unchanged or minimally modified) ──────────────────────

model JobPayment {
  id                      String        @id @default(uuid())
  jobId                   String        @unique
  stripePaymentIntentId   String        @unique
  totalAmount             Float
  platformFeePctSnapshot  Float         // Snapshot of fee % at time of payment
  commissionPctSnapshot   Float         // Snapshot of commission % at time of payment
  platformFeeAmount       Float
  commissionAmount        Float
  hiredAmount             Float
  status                  PaymentStatus @default(pending)
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@map("job_payments")
}

model Commission {
  id               String           @id @default(uuid())
  jobId            String           @unique
  referrerId       String
  amount           Float
  status           CommissionStatus @default(pending)
  stripeTransferId String?
  createdAt        DateTime         @default(now())
  paidAt           DateTime?

  job      Job  @relation(fields: [jobId], references: [id])
  referrer User @relation(fields: [referrerId], references: [id])

  @@index([referrerId])
  @@index([status])
  @@map("commissions")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(incomplete)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Review {
  id         String   @id @default(uuid())
  jobId      String
  reviewerId String
  revieweeId String
  rating     Int      // 1-5
  text       String
  dimension  String   @default("general") // "job_quality" | "referral_quality" | "client_facing" | "general"
  isFlagged  Boolean  @default(false)
  createdAt  DateTime @default(now())

  job      Job  @relation(fields: [jobId], references: [id])
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([jobId, reviewerId, revieweeId, dimension]) // One review per direction per dimension per job
  @@index([revieweeId])
  @@index([isFlagged])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  jobId      String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
  job      Job  @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model PlatformSetting {
  key         String   @id
  value       String
  description String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // e.g. "UPDATE_SETTING", "SUSPEND_USER", "DELETE_JOB"
  entityType String   // e.g. "User", "Job", "PlatformSetting"
  entityId   String?
  oldValue   String?  // JSON serialized
  newValue   String?  // JSON serialized
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Direct Messages — contractor-to-contractor chat ─────────────────────────

model DirectMessage {
  id           String    @id @default(uuid())
  senderId     String
  receiverId   String
  content      String
  attachments  Json?     // [{ url, name, type, size }]
  isRead       Boolean   @default(false)
  readAt       DateTime?
  isDeleted    Boolean   @default(false)
  reactions    Json?     // { "👍": ["userId1"], "❤️": ["userId2"] }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sender   User @relation("DmSent", fields: [senderId], references: [id])
  receiver User @relation("DmReceived", fields: [receiverId], references: [id])

  reports  MessageReport[]

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
  @@index([createdAt])
  @@map("direct_messages")
}

// ─── Message Reports — flagged messages for admin review ─────────────────────

model MessageReport {
  id          String   @id @default(uuid())
  messageId   String
  reporterId  String
  reason      String
  adminNotes  String?
  status      String   @default("pending") // pending, reviewed, dismissed
  createdAt   DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id])

  @@index([status])
  @@map("message_reports")
}
